# Public S3 base URL for reading season JSON files (Terraform output: s3_seasons_base_url)
VITE_SEASONS_BASE_URL=

# API Gateway invoke URL for writing season JSON (Terraform output: api_gateway_invoke_url)
VITE_POOL_API_URL=

# API Gateway API key (Terraform output: api_gateway_api_key)
VITE_POOL_API_KEY=
